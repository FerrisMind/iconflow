# Generated by Cargo
# will have compiled files and executables
/debug
/target
# Leaf-private / isolated CARGO_TARGET_DIR (swarm verify, regen, probes)
/target-*/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Internal docs
/docs_int
/tp

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Agent swarm / local scratch (leaf reports, plans)
.swarm/

# Profiling / benches output
flamegraph.svg
perf.data*
*.profraw
*.profdata
criterion/

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/
env/

# Editor/IDE
.idea/
.vscode/
.cursor/
*.swp
*.swo
*.tmp
*~

